                    { x: 750, y: 350, w: 150, h: 20 },
                    { x: 970, y: 240, w: 160, h: 20 },
                    { x: 1200, y: 340, w: 180, h: 20 },
                    { x: 1450, y: 480, w: 500, h: 60 }
                ],
                collectibles: [
                    { x: 360, y: 310, item: "jade" },
                    { x: 580, y: 210, item: "jade" },
                    { x: 800, y: 300, item: "heart" },
                    { x: 1020, y: 180, item: "jade" },
                    { x: 1260, y: 280, item: "jade" }
                ],
                goal: { x: 1750, y: 360, w: 80, h: 120, type: "wedding_portal" }
            }
        ];

        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');

        // Adapt canvas scale
        canvas.width = CANVAS_WIDTH;
        canvas.height = CANVAS_HEIGHT;

        // Input state tracker
        const keys = {
            left: false,
            right: false,
            jump: false,
            switch: false
        };

        // Game Global State
        let currentStageIndex = 0;
        let gameActive = false;
        let dialogueActive = false;
        let collectiblesCount = 0;
        let cameraX = 0;
        let activeCharacter = "xiaob"; // "xiaob" or "matthe"

        // Player physics object
        const player = {
            x: 50,
            y: 350,
            w: 36,
            h: 64,
            vx: 0,
            vy: 0,
            speed: 5.5,
            jumpPower: -12.5,
            grounded: false,
            facing: 'right',
            animFrame: 0,
            animTimer: 0
        };

        // Particle System for Effects
        let particles = [];

        function createSparkles(x, y, color = "#f43f5e") {
            for (let i = 0; i < 12; i++) {
                particles.push({
                    x: x,
                    y: y,
                    vx: (Math.random() - 0.5) * 6,
                    vy: (Math.random() - 0.5) * 6 - 2,
                    size: Math.random() * 6 + 3,
                    color: color,
                    life: 1.0
                });
            }
        }

        // Draw Cute procedural character - 小B (1998, Pink/Brown style)
        function drawXiaoB(c, x, y, facing, animFrame) {
            c.save();
            c.translate(x + 18, y + 32);
            if (facing === 'left') c.scale(-1, 1);

            // Bobbing animation offset
            const bob = Math.sin(animFrame * 0.2) * 2;

            // Hair (Long Brown)
            c.fillStyle = "#654321";
            c.beginPath();
            c.arc(0, -14 + bob, 16, 0, Math.PI * 2);
            c.fill();
            c.fillRect(-15, -14 + bob, 30, 22);

            // Body (Pink Top)
            c.fillStyle = "#f43f5e";
            c.beginPath();
            c.roundRect(-10, 2 + bob, 20, 18, 5);
            c.fill();

            // Skirt (White/Pink)
            c.fillStyle = "#fbcfe8";
            c.beginPath();
            c.moveTo(-12, 18 + bob);
            c.lineTo(12, 18 + bob);
            c.lineTo(15, 26 + bob);
            c.lineTo(-15, 26 + bob);
            c.closePath();
            c.fill();

            // Head (Skin tone)
            c.fillStyle = "#ffdfc4";
            c.beginPath();
            c.arc(0, -12 + bob, 12, 0, Math.PI * 2);
            c.fill();

            // Eyes & Smile
            c.fillStyle = "#1e293b";
            c.beginPath();
            c.arc(4, -13 + bob, 2, 0, Math.PI * 2);
            c.fill();
            
            c.strokeStyle = "#e11d48";
            c.lineWidth = 1.5;
            c.beginPath();
            c.arc(4, -9 + bob, 3, 0.1, Math.PI - 0.1);
            c.stroke();

            // Cute Blue Crossbody Bag (Matching image reference)
            c.fillStyle = "#38bdf8";
            c.fillRect(2, 6 + bob, 8, 8);
            c.strokeStyle = "#0284c7";
            c.lineWidth = 1.5;
            c.beginPath();
            c.moveTo(-8, 2 + bob);
            c.lineTo(4, 10 + bob);
            c.stroke();

            // Legs
            const legOffset = Math.sin(animFrame * 0.3) * 6;
            c.fillStyle = "#ffdfc4";
            c.fillRect(-6, 26 + bob, 4, 8 + legOffset);
            c.fillRect(2, 26 + bob, 4, 8 - legOffset);

            c.restore();
        }

        // Draw Cute procedural character - Matthe (1993, Green/Teal shirt, Dark hair)
        function drawMatthe(c, x, y, facing, animFrame) {
            c.save();
            c.translate(x + 18, y + 32);
            if (facing === 'left') c.scale(-1, 1);

            const bob = Math.sin(animFrame * 0.2) * 2;

            // Head & Face
            c.fillStyle = "#ffdfc4";
            c.beginPath();
            c.arc(0, -14 + bob, 12, 0, Math.PI * 2);
            c.fill();

            // Dark Short Neat Hair
            c.fillStyle = "#2d3748";
            c.beginPath();
            c.arc(0, -16 + bob, 14, Math.PI, Math.PI * 2);
            c.fill();
            c.fillRect(-13, -18 + bob, 26, 6);

            // Body (Teal/Green Button Shirt - matching image)
            c.fillStyle = "#0d9488";
            c.beginPath();
            c.roundRect(-11, -2 + bob, 22, 22, 4);
            c.fill();

            // Shirt collar details
            c.strokeStyle = "#ccfbf1";
            c.lineWidth = 2;
            c.beginPath();
            c.moveTo(-4, -2 + bob);
            c.lineTo(0, 4 + bob);
            c.lineTo(4, -2 + bob);
            c.stroke();

            // Pants (Dark Blue)
            c.fillStyle = "#1e293b";
            c.fillRect(-10, 18 + bob, 20, 10);

            // Eyes & Gentle Smile
            c.fillStyle = "#0f172a";
            c.beginPath();
            c.arc(4, -14 + bob, 2, 0, Math.PI * 2);
            c.fill();

            c.strokeStyle = "#475569";
            c.lineWidth = 1.5;
            c.beginPath();
            c.arc(3, -10 + bob, 3, 0.2, Math.PI - 0.2);
            c.stroke();

            // Legs
            const legOffset = Math.sin(animFrame * 0.3) * 6;
            c.fillStyle = "#334155";
            c.fillRect(-6, 28 + bob, 5, 8 + legOffset);
            c.fillRect(2, 28 + bob, 5, 8 - legOffset);

            c.restore();
        }

        // Draw Stage Backgrounds & Visual themes
        function drawBackground(bgType) {
            const level = LEVEL_DATA[currentStageIndex];

            if (bgType === 'hku') {
                // HKU Campus sky gradient
                const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
                grad.addColorStop(0, "#bae6fd");
                grad.addColorStop(1, "#fef3c7");
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

                // HKU Clocktower Background Silhouette
                ctx.fillStyle = "#94a3b8";
                const towerX = 1600 - cameraX;
                ctx.fillRect(towerX, 150, 80, 250);
                // Clocktower roof
                ctx.beginPath();
                ctx.moveTo(towerX - 10, 150);
                ctx.lineTo(towerX + 40, 70);
                ctx.lineTo(towerX + 90, 150);
                ctx.fill();
                // Clock face
                ctx.fillStyle = "#fef08a";
                ctx.beginPath();
                ctx.arc(towerX + 40, 200, 20, 0, Math.PI * 2);
                ctx.fill();
                ctx.strokeStyle = "#475569";
                ctx.lineWidth = 3;
                ctx.stroke();

            } else if (bgType === 'separation') {
                // Separation Stage - Cloudy/Melancholy sky gradient
                const grad = ctx.createLinearGradient(0, 0, 0, CANVAS_HEIGHT);
                grad.addColorStop(0, "#334155");
                grad.addColorStop(1, "#64748b");
                ctx.fillStyle = grad;
                ctx.fillRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

                // Separation Cloud shapes
                ctx.fillStyle = "rgba(255, 255, 255, 0.15)";
        // Quiz System State
        let selectedOptionIndex = null;
        let quizActive = false;

        function initStage(stageIdx) {
            currentStageIndex = stageIdx;
            const stage = LEVEL_DATA[stageIdx];

            // Reset character and items
            player.x = 50;
            player.y = 350;
            player.vx = 0;
            player.vy = 0;
            player.grounded = false;

            collectiblesCount = 0;
            cameraX = 0;

            if (stage.character === "小bb") activeCharacter = "xiaob";
            else if (stage.character === "Matthew") activeCharacter = "matthe";
            else activeCharacter = "xiaob"; // Stage 3 start as xiaob

            // Clone stage collectibles
            stage.currentCollectibles = stage.collectibles.map(c => ({...c, collected: false}));

            // Update UI Header
            document.getElementById('stageTitle').innerText = stage.title;
            document.getElementById('characterBadge').innerText = activeCharacter === "xiaob" ? "女主角：小bb" : "男主角：Matthew";
            document.getElementById('characterBadge').className = `${stage.badgeBg} text-white px-2 py-0.5 rounded font-extrabold text-xs`;
            document.getElementById('collectibleCount').innerText = `0 / ${stage.targetCollectibles}`;

            // Show stage switch button only in Stage 3
            if (stage.id === 3) {
                document.getElementById('btnSwitch').classList.remove('hidden');
            } else {
                document.getElementById('btnSwitch').classList.add('hidden');
            }

            // Show Dialogue Intro
            showDialogue(stage.introSpeaker, stage.introText, `STAGE ${stage.id}`);
        }

        // Show Worksheet Quiz Modal
        function showQuizModal(stageIdx) {
            gameActive = false;
            quizActive = true;
            selectedOptionIndex = null;

            const stage = LEVEL_DATA[stageIdx];
            const quiz = stage.quiz;

            document.getElementById('quizStageTag').innerText = `STAGE ${stage.id} 關卡考驗`;
            document.getElementById('quizQuestion').innerText = quiz.question;

            const optionsContainer = document.getElementById('quizOptions');
            optionsContainer.innerHTML = '';

            quiz.options.forEach((optText, index) => {
                const btn = document.createElement('button');
                btn.className = "quiz-opt-btn w-full text-left p-3 rounded-xl border-2 border-slate-200 hover:border-sky-400 hover:bg-sky-50 text-xs md:text-sm font-semibold transition flex items-center justify-between";
                btn.innerHTML = `<span>${optText}</span> <i class="fa-regular fa-circle text-slate-300 text-lg"></i>`;
                
                btn.onclick = () => {
                    selectedOptionIndex = index;
                    // Reset styling on all options
                    document.querySelectorAll('.quiz-opt-btn').forEach((b, i) => {
                        b.className = "quiz-opt-btn w-full text-left p-3 rounded-xl border-2 border-slate-200 hover:border-sky-400 hover:bg-sky-50 text-xs md:text-sm font-semibold transition flex items-center justify-between";
                        b.querySelector('i').className = "fa-regular fa-circle text-slate-300 text-lg";
                    });
                    // Highlight selected
                    btn.className = "quiz-opt-btn w-full text-left p-3 rounded-xl border-2 border-amber-500 bg-amber-50 text-xs md:text-sm font-bold text-amber-900 transition flex items-center justify-between shadow-sm";
                    btn.querySelector('i').className = "fa-solid fa-circle-check text-amber-600 text-lg";

                    document.getElementById('submitQuizBtn').disabled = false;
                };

                optionsContainer.appendChild(btn);
            });

            // Reset feedback display
            const feedbackBox = document.getElementById('quizFeedback');
            feedbackBox.classList.add('hidden');

            document.getElementById('submitQuizBtn').disabled = true;
            document.getElementById('quizModal').classList.remove('hidden');
        }

        // Submit Quiz Answer Handler
        document.getElementById('submitQuizBtn').addEventListener('click', () => {
            if (selectedOptionIndex === null) return;

            const stage = LEVEL_DATA[currentStageIndex];
            const feedbackBox = document.getElementById('quizFeedback');

            if (selectedOptionIndex === stage.quiz.correctIndex) {
                // Correct Answer!
                sound.playWin();
                feedbackBox.className = "p-3 rounded-xl text-xs md:text-sm font-bold text-center mb-3 bg-emerald-100 text-emerald-800 border border-emerald-300 block";
                feedbackBox.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> 答對了！非常了解《逐玉故書》工作紙情節！`;

                setTimeout(() => {
                    document.getElementById('quizModal').classList.add('hidden');
                    quizActive = false;

                    if (currentStageIndex < LEVEL_DATA.length - 1) {
                        initStage(currentStageIndex + 1);
                    } else {
                        // All stages finished -> Victory screen
                        gameActive = false;
                        document.getElementById('victoryOverlay').classList.remove('hidden');
                    }
                }, 1200);

            } else {
                // Wrong Answer!
                feedbackBox.className = "p-3 rounded-xl text-xs md:text-sm font-bold text-center mb-3 bg-rose-100 text-rose-800 border border-rose-300 block animate-shake";
                feedbackBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-600 mr-1"></i> 答案不太對哦！可以點擊右上角「故事工作紙」複習一下！`;
            }
        });

        function switchCharacter() {
            if (LEVEL_DATA[currentStageIndex].id !== 3) return;
            activeCharacter = activeCharacter === "xiaob" ? "matthe" : "xiaob";
            sound.playJump();
            createSparkles(player.x - cameraX + 18, player.y + 32, activeCharacter === "xiaob" ? "#f43f5e" : "#0d9488");
            document.getElementById('characterBadge').innerText = activeCharacter === "xiaob" ? "女主角：小bb" : "男主角：Matthew";
            document.getElementById('characterBadge').className = activeCharacter === "xiaob" ? "bg-pink-500 text-white px-2 py-0.5 rounded font-extrabold text-xs" : "bg-teal-600 text-white px-2 py-0.5 rounded font-extrabold text-xs";
        }

        // Main Physics & Movement Update
        function update() {
            if (!gameActive || dialogueActive || quizActive) return;

            const stage = LEVEL_DATA[currentStageIndex];

            // Horizontal input handling
            if (keys.left) {
                player.vx = -player.speed;
                player.facing = 'left';
            } else if (keys.right) {
                player.vx = player.speed;
                player.facing = 'right';
            } else {
                player.vx *= 0.7; // Friction
            }

            // Jump input handling
            if (keys.jump && player.grounded) {
                player.vy = player.jumpPower;
                player.grounded = false;
                sound.playJump();
                createSparkles(player.x - cameraX + 18, player.y + 60, "#ffffff");
            }

            // Gravity
            player.vy += 0.65;

            // Apply horizontal velocity
            player.x += player.vx;

            // Left boundary check
            if (player.x < 0) player.x = 0;

            // Platform Collision Detection
            player.grounded = false;
            for (let plat of stage.platforms) {
                if (
                    player.x + player.w > plat.x &&
                    player.x < plat.x + plat.w &&
                    player.y + player.h >= plat.y &&
                    player.y + player.h <= plat.y + plat.h &&
                    player.vy >= 0
                ) {
                    player.y = plat.y - player.h;
                    player.vy = 0;
                    player.grounded = true;
                }
            }

            // Apply vertical velocity
            player.y += player.vy;

            // Death/Fell in gap check
            if (player.y > CANVAS_HEIGHT + 100) {
                // Respawn
                player.x = 50;
                player.y = 300;
                player.vy = 0;
            }

            // Camera tracking
            cameraX = player.x - 200;
            if (cameraX < 0) cameraX = 0;

            // Collectibles collision check
            stage.currentCollectibles.forEach((item) => {
                if (!item.collected) {
                    const dx = player.x + player.w / 2 - item.x;
                    const dy = player.y + player.h / 2 - item.y;
                    if (Math.abs(dx) < 28 && Math.abs(dy) < 32) {
                        item.collected = true;
                        collectiblesCount++;
                        sound.playCollect();
                        createSparkles(item.x - cameraX, item.y, "#fef08a");
                        document.getElementById('collectibleCount').innerText = `${collectiblesCount} / ${stage.targetCollectibles}`;
                    }
                }
            });

            // Goal/Portal Collision Check
            const goal = stage.goal;
            if (
                player.x + player.w > goal.x &&
                player.x < goal.x + goal.w &&
                player.y + player.h > goal.y
            ) {
                if (collectiblesCount >= stage.targetCollectibles) {
                    // Collectibles complete -> Trigger Worksheet Quiz!
                    sound.playCollect();
                    showQuizModal(currentStageIndex);
                }
            }

            // Animation frame counter
            if (Math.abs(player.vx) > 0.5) {
                player.animTimer++;
                if (player.animTimer % 4 === 0) player.animFrame++;
            } else {
                player.animFrame = 0;
            }

            // Particles Update
            for (let i = particles.length - 1; i >= 0; i--) {
                const p = particles[i];
                p.x += p.vx;
                p.y += p.vy;
                p.life -= 0.04;
                if (p.life <= 0) particles.splice(i, 1);
            }
        }

        // Draw Game Canvas Scene
        function render() {
            ctx.clearRect(0, 0, CANVAS_WIDTH, CANVAS_HEIGHT);

            const stage = LEVEL_DATA[currentStageIndex];

            // 1. Background
            drawBackground(stage.bgType);

            // 2. Draw Platforms
            stage.platforms.forEach(plat => {
                ctx.fillStyle = "#334155";
                ctx.beginPath();
                ctx.roundRect(plat.x - cameraX, plat.y, plat.w, plat.h, 6);
                ctx.fill();

                // Top grass/highlight edge
                ctx.fillStyle = stage.bgType === 'hku' ? "#4ade80" : stage.bgType === 'separation' ? "#94a3b8" : "#fb7185";
                ctx.fillRect(plat.x - cameraX, plat.y, plat.w, 6);
            });

            // 3. Draw Collectibles
            stage.currentCollectibles.forEach(item => {
                if (!item.collected) drawCollectible(item);
            });

            // 4. Draw Goal / NPC at end
            const goal = stage.goal;
            if (goal.type === "matthe_npc") {
                drawMatthe(ctx, goal.x - cameraX, goal.y, "left", 0);
            } else if (goal.type === "xiaob_npc") {
                drawXiaoB(ctx, goal.x - cameraX, goal.y, "left", 0);
            } else if (goal.type === "wedding_portal") {
                // Heart Gate Goal
                ctx.save();
                ctx.translate(goal.x - cameraX + 40, goal.y + 60);
                ctx.fillStyle = "rgba(244, 63, 94, 0.8)";
                ctx.beginPath();
                ctx.arc(-20, -20, 30, 0, Math.PI * 2);
                ctx.arc(20, -20, 30, 0, Math.PI * 2);
                ctx.lineTo(0, 40);
                ctx.fill();
                ctx.restore();
            }

            // 5. Draw Player Character
            if (activeCharacter === "xiaob") {
                drawXiaoB(ctx, player.x - cameraX, player.y, player.facing, player.animFrame);
            } else {
                drawMatthe(ctx, player.x - cameraX, player.y, player.facing, player.animFrame);
            }

            // 6. Draw Sparkle Particles
            particles.forEach(p => {
                ctx.fillStyle = p.color;
                ctx.globalAlpha = p.life;
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.size, 0, Math.PI * 2);
                ctx.fill();
                ctx.globalAlpha = 1.0;
            });
        }

        // Main Animation Loop
        function gameLoop() {
            update();
            render();
            requestAnimationFrame(gameLoop);
        }

        // Keyboard Listener
        window.addEventListener('keydown', (e) => {
            sound.init();
            if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.left = true;
            if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.right = true;
            if (e.code === 'KeyW' || e.code === 'Space' || e.code === 'ArrowUp') keys.jump = true;
            if (e.code === 'KeyE') switchCharacter();
        });

        window.addEventListener('keyup', (e) => {
            if (e.code === 'KeyA' || e.code === 'ArrowLeft') keys.left = false;
            if (e.code === 'KeyD' || e.code === 'ArrowRight') keys.right = false;
            if (e.code === 'KeyW' || e.code === 'Space' || e.code === 'ArrowUp') keys.jump = false;
        });

        // Touch Control Listeners
        const setupTouchBtn = (id, keyName) => {
            const btn = document.getElementById(id);
            btn.addEventListener('touchstart', (e) => {
                e.preventDefault();
                sound.init();
                keys[keyName] = true;
            });
            btn.addEventListener('touchend', (e) => {
                e.preventDefault();
                keys[keyName] = false;
            });
        };

        setupTouchBtn('btnLeft', 'left');
        setupTouchBtn('btnRight', 'right');
        setupTouchBtn('btnJump', 'jump');

        document.getElementById('btnSwitch').addEventListener('click', () => {
            switchCharacter();
        });

        // UI Event Handlers
        document.getElementById('startGameBtn').addEventListener('click', () => {
            sound.init();
            document.getElementById('startScreen').classList.add('hidden');
            document.getElementById('hudOverlay').classList.remove('hidden');
            document.getElementById('touchControls').classList.remove('hidden');
            document.getElementById('touchControls').classList.add('flex');
            initStage(0);
        });

        document.getElementById('nextDialogBtn').addEventListener('click', () => {
            sound.init();
            hideDialogue();
        });

        document.getElementById('worksheetBtn').addEventListener('click', () => {
            sound.init();
            document.getElementById('worksheetModal').classList.remove('hidden');
        });

        document.getElementById('closeWorksheetBtn').addEventListener('click', () => {
            document.getElementById('worksheetModal').classList.add('hidden');
        });

        document.getElementById('resumeFromWorksheetBtn').addEventListener('click', () => {
            document.getElementById('worksheetModal').classList.add('hidden');
        });

        document.getElementById('restartGameBtn').addEventListener('click', () => {
            document.getElementById('victoryOverlay').classList.add('hidden');
            initStage(0);
        });

        // Window Load Handler
        window.onload = function () {
            gameLoop();
        };
    </script>
